<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_tree_extended" model="ir.ui.view">
        <field name="name">account.move.tree.extended</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
           <xpath expr="//field[@name='status_in_payment']" position="attributes">
                <attribute name="decoration-danger">payment_state == 'not_paid' and state != 'cancel'</attribute>
                <attribute name="decoration-muted">state == 'cancel'</attribute>
                <attribute name="decoration-warning">payment_state in ('partial', 'in_payment')</attribute>
                <attribute name="decoration-success">payment_state in ('paid', 'reversed')</attribute>
                <attribute name="decoration-info">state == 'draft'</attribute>
           </xpath>
        </field>
    </record>
</odoo>
