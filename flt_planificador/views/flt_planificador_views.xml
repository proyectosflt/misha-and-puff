<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Lista (Histórico de Planificaciones) -->
    <record id="view_flt_planificador_list" model="ir.ui.view">
        <field name="name">flt.planificador.list</field>
        <field name="model">flt.planificador</field>
        <field name="arch" type="xml">
            <list string="Planificaciones">
                <field name="name"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario (Oculta la cabecera para enfocar en la tabla incrustada) -->
    <record id="view_flt_planificador_form" model="ir.ui.view">
        <field name="name">flt.planificador.form</field>
        <field name="model">flt.planificador</field>
        <field name="arch" type="xml">
            <form string="Planificación">
                <sheet>
                    <div class="oe_title" invisible="1">
                        <h1><field name="name"/></h1>
                    </div>
                    <group invisible="1">
                        <field name="date"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="fecha_planificada"/>
                            <field name="pri_tp"/>
                            <field name="temporada"/>
                            <field name="programa"/>
                            <field name="pri_cp"/>
                            <field name="partner_id"/>
                            <field name="pri_prod"/>
                            <field name="product_id"/>
                            <field name="cantidad_requerida"/>
                            <field name="sale_order_id"/>
                            <field name="picking_ids" widget="many2many_tags"/>
                            <field name="state" 
                                   widget="badge" 
                                   decoration-warning="state == 'pendiente'" 
                                   decoration-success="state == 'procesada'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_flt_planificador" model="ir.actions.act_window">
        <field name="name">Planificación</field>
        <field name="res_model">flt.planificador</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>