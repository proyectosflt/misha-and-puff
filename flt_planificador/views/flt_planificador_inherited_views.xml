<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Herencia en Sale Order (Lista y Formulario) -->
    <record id="view_order_tree_inherit_planificador" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.planificador</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="temporada" optional="show"/>
                <field name="programa" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_order_form_inherit_planificador" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.planificador</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="temporada"/>
                <field name="programa"/>
            </field>
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Líneas de Planificación" name="planificador_lines">
                    <field name="planificador_line_ids"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Herencia en Stock Picking (Lista y Formulario) -->
    <record id="vpicktree_inherit_planificador" model="ir.ui.view">
        <field name="name">stock.picking.list.inherit.planificador</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="temporada" optional="show"/>
                <field name="programa" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_picking_form_inherit_planificador" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.planificador</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="temporada"/>
                <field name="programa"/>
            </field>
            <xpath expr="//page[@name='extra']" position="after">
                <page string="Líneas de Planificación" name="planificador_lines">
                    <field name="planificador_line_ids"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>