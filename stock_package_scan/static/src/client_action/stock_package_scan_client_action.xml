<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="stock_package_scan.ClientAction">
    <div class="o_package_scan_action d-flex flex-column h-100">

        <div class="o_package_scan_header p-3 border-bottom">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h4 class="mb-0" t-esc="state.name"/>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge text-bg-secondary" t-if="state.lineCount">
                        <t t-esc="state.scannedCount"/> / <t t-esc="state.lineCount"/> escaneados
                    </span>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            t-on-click="openForm">
                        <i class="fa fa-external-link me-1"/>
                        Abrir formulario
                    </button>
                </div>
            </div>
            <p class="text-muted mb-2" t-if="state.productName">
                Mostrando paquetes para: <strong t-esc="state.productName"/>
            </p>
            <div class="position-relative">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fa fa-barcode"/>
                    </span>
                    <input type="text"
                           class="form-control o_package_scan_input"
                           t-ref="barcodeInput"
                           placeholder="Escanee o escriba el código de barras de un paquete"
                           t-model="state.manualValue"
                           t-on-keydown="onManualKeydown"
                           autocomplete="off"/>
                </div>
            </div>
        </div>

        <div class="o_package_scan_lines flex-grow-1 overflow-auto p-3">
            <div t-if="!state.lines.length" class="text-center text-muted mt-5">
                <i class="fa fa-search fa-2x mb-2"/>
                <p>Escanee un paquete para identificar su producto y listar los demás paquetes disponibles.</p>
            </div>

            <div t-foreach="state.lines" t-as="line" t-key="line.id"
                 t-on-click="() => this.onLineClick(line)"
                 t-attf-class="o_package_scan_line d-flex align-items-center justify-content-between p-3 mb-2 rounded border {{ line.scanned ? 'o_package_scan_line_done' : '' }}">
                <div>
                    <div class="fw-bold" t-esc="line.package_id[1]"/>
                    <div class="text-muted small" t-if="line.location_id" t-esc="line.location_id[1]"/>
                    <div class="text-muted small" t-if="line.product_uom_id">
                        Unidad de medida: <t t-esc="line.product_uom_id[1]"/>
                    </div>
                    <div class="text-muted small">
                        Conos: <t t-esc="line.cantidad_conos"/>
                    </div>
                    <div class="text-muted small">
                        Cantidad bruto: <t t-esc="line.peso_bruto"/>
                    </div>
                    <div class="text-muted small">
                        Cantidad neto: <t t-esc="line.product_qty"/>
                    </div>
                </div>
                <i t-attf-class="fa fa-2x {{ line.scanned ? 'fa-check-circle text-success' : 'fa-circle-o text-muted' }}"/>
            </div>
        </div>

    </div>
</t>

</templates>
