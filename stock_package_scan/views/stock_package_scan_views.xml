<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_package_scan_form" model="ir.ui.view">
        <field name="name">stock.package.scan.form</field>
        <field name="model">stock.package.scan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_scanner" type="object"
                            string="Open Scanner" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            invisible="state != 'in_progress'"/>
                    <button name="action_reset" type="object" string="Reset"
                            invisible="state == 'draft'"
                            confirm="This clears every scanned line. Continue?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="location_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="date"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Packages">
                            <field name="line_ids">
                                <list editable="bottom" decoration-success="scanned == True">
                                    <field name="package_id" readonly="1"/>
                                    <field name="location_id" readonly="1"/>
                                    <field name="product_qty" readonly="1"/>
                                    <field name="scanned" widget="boolean_toggle"/>
                                    <field name="scanned_date" readonly="1"/>
                                    <field name="scanned_by" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_package_scan_list" model="ir.ui.view">
        <field name="name">stock.package.scan.list</field>
        <field name="model">stock.package.scan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="user_id"/>
                <field name="date"/>
                <field name="scanned_count" string="Scanned"/>
                <field name="line_count" string="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'in_progress'"/>
            </list>
        </field>
    </record>

    <record id="view_stock_package_scan_search" model="ir.ui.view">
        <field name="name">stock.package.scan.search</field>
        <field name="model">stock.package.scan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="user_id"/>
                <filter name="in_progress" string="In Progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter name="done" string="Done"
                        domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_package_scan" model="ir.actions.act_window">
        <field name="name">Package Scans</field>
        <field name="res_model">stock.package.scan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No scan sessions yet — use "Scan Packages" to start one.
            </p>
        </field>
    </record>

</odoo>
