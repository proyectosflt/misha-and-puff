<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="stock_barcode.MainComponent" t-inherit-mode="extension">
        <xpath expr="//button[contains(@t-on-click, 'openInventory') or contains(., 'Conteo de inventario')]" position="after">
            <button class="btn btn-info btn-lg text-white w-100 mt-2 py-3 fw-bold shadow-sm o_stock_barcode_package_count_btn"
                    t-on-click="openPackageCount">
                <i class="fa fa-cubes me-2"/> Conteo de paquetes
            </button>
        </xpath>
    </t>
</templates>