    <!-- ======================================================== -->
    <!-- 3. MENUS DEFINITIONS (With Actions Linked)               -->
    <!-- ======================================================== -->
    <menuitem id="menu_product_rubro" name="Rubros" parent="stock.menu_product_in_config_stock" action="action_product_rubro" sequence="53"/>
    <menuitem id="menu_product_familia" name="Familias" parent="stock.menu_product_in_config_stock" action="action_product_familia" sequence="54"/>
