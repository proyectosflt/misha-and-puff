<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================== -->
    <!-- 1. VIEWS DEFINITIONS (List & Form)                       -->
    <!-- ======================================================== -->
    
    <record id="view_product_rubro_tree" model="ir.ui.view">
        <field name="name">product.rubro.tree</field>
        <field name="model">product.rubro</field>
        <field name="arch" type="xml">
            <list string="Rubros">
                <field name="codigo"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_product_rubro_form" model="ir.ui.view">
        <field name="name">product.rubro.form</field>
        <field name="model">product.rubro</field>
        <field name="arch" type="xml">
            <form string="Rubro">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Hilados"/>
                        </group>
                        <group>
                            <field name="codigo" placeholder="e.g. RUB-01"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_familia_tree" model="ir.ui.view">
        <field name="name">product.familia.tree</field>
        <field name="model">product.familia</field>
        <field name="arch" type="xml">
            <list string="Familias">
                <field name="codigo"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_product_familia_form" model="ir.ui.view">
        <field name="name">product.familia.form</field>
        <field name="model">product.familia</field>
        <field name="arch" type="xml">
            <form string="Familia">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Algodón"/>
                        </group>
                        <group>
                            <field name="codigo" placeholder="e.g. FAM-01"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_type_tree" model="ir.ui.view">
        <field name="name">product.type.tree</field>
        <field name="model">product.type</field>
        <field name="arch" type="xml">
            <list string="Tipos">
                <field name="codigo"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_product_type_form" model="ir.ui.view">
        <field name="name">product.type.form</field>
        <field name="model">product.type</field>
        <field name="arch" type="xml">
            <form string="Tipo">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Cono"/>
                        </group>
                        <group>
                            <field name="codigo" placeholder="e.g. TYP-01"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    

    <!-- ======================================================== -->
    <!-- 2. ACTIONS DEFINITIONS                                   -->
    <!-- ======================================================== -->
    <record id="action_product_rubro" model="ir.ui.actions.act_window">
        <field name="name">Rubros</field>
        <field name="res_model">product.rubro</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Rubro!</p>
        </field>
    </record>

    <record id="action_product_familia" model="ir.ui.actions.act_window">
        <field name="name">Familias</field>
        <field name="res_model">product.familia</field>
        <field name="view_mode">list,form</field>
