<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="label_package_template_view_inherit" inherit_id="stock.label_package_template_view">
            <xpath expr="//t[@t-translation='off']" position="replace">
                <t t-translation="off">
^XA
^PW812
^LL1218
<!-- TEXT SIZING: ^A0N,h,w squashes the glyphs when w sits far below h, so width is pinned at
     PROP x height (the ratio this label used at 4x3) and the pair is scaled down only as far
     as the string length demands. FIT is the per-character advance as a fraction of w: lower
     it if a long line runs past the edge, raise it if long lines come out too small. -->
<t t-set="fit" t-value="0.7"/>
<t t-set="prop" t-value="0.85"/>
<t t-set="head_wmax" t-value="123"/>
<t t-set="foot_wmax" t-value="140"/>

<t t-set="quant" t-value="package.quant_ids and package.quant_ids[0]"/>
<t t-set="tmpl" t-value="quant.product_tmpl_id if quant else False"/>
<t t-if="tmpl">
    <t t-set="tenido" t-value="tmpl.product_tenido_id.codigo or ''"/>
    <t t-set="color" t-value="tmpl.product_color_id.codigo or ''"/>
    <t t-set="top_line" t-value="((tenido + '-') if (tenido and color) else tenido) + color"/>

    <t t-set="props" t-value="tmpl.product_familia_id.property_ids.sorted(lambda p: p.sequence)"/>
    <t t-set="rest_codes" t-value="[tmpl[p.property_field].codigo for p in props if p.property_field not in ('product_tenido_id', 'product_color_id') and tmpl[p.property_field] and tmpl[p.property_field].codigo]"/>
    <t t-set="sub_line" t-value="'-'.join(rest_codes)"/>
    <t t-set="id_str" t-value="str(tmpl.id)"/>

    <t t-set="top_w" t-value="min(int(780 / (fit * (len(top_line) or 1))), head_wmax)"/>
    <t t-set="top_h" t-value="int(top_w / prop)"/>
    <t t-set="sub_w" t-value="min(int(780 / (fit * (len(sub_line) or 1))), head_wmax)"/>
    <t t-set="sub_h" t-value="int(sub_w / prop)"/>
    <t t-set="id_w" t-value="min(int(780 / (fit * len(id_str))), head_wmax)"/>
    <t t-set="id_h" t-value="int(id_w / prop)"/>

    <t t-set="y2" t-value="25 + top_h + 12"/>
    <t t-set="y3" t-value="y2 + sub_h + 12"/>

^FO0,25^FB812,1,0,C^A0N,<t t-out="top_h"/>,<t t-out="top_w"/>^FD<t t-out="top_line"/>^FS
^FO0,<t t-out="y2"/>^FB812,1,0,C^A0N,<t t-out="sub_h"/>,<t t-out="sub_w"/>^FD<t t-out="sub_line"/>^FS
^FO0,<t t-out="y3"/>^FB812,1,0,C^A0N,<t t-out="id_h"/>,<t t-out="id_w"/>^FD<t t-out="id_str"/>^FS
</t>

<!-- DYNAMIC BARCODE CENTERING MATH IN QWEB (module width 3) -->
<t t-set="barcode_val" t-value="package.name"/>
<t t-set="barcode_len" t-value="len(barcode_val) if barcode_val else 0"/>
<t t-set="barcode_x" t-value="int(353.5 - (barcode_len * 16.5))"/>
<t t-if="barcode_x &lt; 10">
    <t t-set="barcode_x" t-value="10"/>
</t>

^CF0,65,55
^FO<t t-out="barcode_x"/>,520^BY3,3,235
^BCN,235,Y,N,N
^FD<t t-out="barcode_val"/>^FS

<!-- FOOTER VALUES -->
^FO10,881^FB250,1,0,C^A0N,60,51^FDCONOS^FS
^FO280,881^FB250,1,0,C^A0N,60,51^FDKGB^FS
^FO550,881^FB250,1,0,C^A0N,60,51^FDKGN^FS

<t t-set="conos_val" t-value="package.cantidad_conos or ''"/>
<t t-set="bruto_val" t-value="package.peso_bruto or ''"/>
<t t-set="neto_val" t-value="package.peso_neto or ''"/>
<!-- One size for the whole row, driven by the longest of the three -->
<t t-set="foot_len" t-value="max(len(str(conos_val)), len(str(bruto_val)), len(str(neto_val))) or 1"/>
<t t-set="foot_w" t-value="min(int(235 / (fit * foot_len)), foot_wmax)"/>
<t t-set="foot_h" t-value="int(foot_w / prop)"/>

^FO10,983^FB250,1,0,C^A0N,<t t-out="foot_h"/>,<t t-out="foot_w"/>^FD<t t-out="conos_val"/>^FS
^FO280,983^FB250,1,0,C^A0N,<t t-out="foot_h"/>,<t t-out="foot_w"/>^FD<t t-out="bruto_val"/>^FS
^FO550,983^FB250,1,0,C^A0N,<t t-out="foot_h"/>,<t t-out="foot_w"/>^FD<t t-out="neto_val"/>^FS
^XZ
                </t>
            </xpath>
        </template>
    </data>
</odoo>