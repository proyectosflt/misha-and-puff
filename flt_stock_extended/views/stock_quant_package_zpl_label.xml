<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="label_package_template_view_inherit" inherit_id="stock.label_package_template_view">
            <xpath expr="//t[@t-translation='off']" position="replace">
                <t t-translation="off">
^XA
^PW812
^LL609
<t t-set="quant" t-value="package.quant_ids and package.quant_ids[0]"/>
<t t-set="tmpl" t-value="quant.product_tmpl_id if quant else False"/>
<t t-if="tmpl">
    <t t-set="tenido" t-value="tmpl.product_tenido_id.codigo or ''"/>
    <t t-set="color" t-value="tmpl.product_color_id.codigo or ''"/>
    <t t-set="top_line" t-value="((tenido + '-') if (tenido and color) else tenido) + color"/>
    
    <t t-set="props" t-value="tmpl.product_familia_id.property_ids.sorted(lambda p: p.sequence)"/>
    <t t-set="rest_codes" t-value="[tmpl[p.property_field].codigo for p in props if p.property_field not in ('product_tenido_id', 'product_color_id') and tmpl[p.property_field] and tmpl[p.property_field].codigo]"/>
    <t t-set="sub_line" t-value="'-'.join(rest_codes)"/>

^FO0,30^FB812,1,0,C^A0N,85,70^FD<t t-out="top_line"/>^FS
^FO0,125^FB812,1,0,C^A0N,65,55^FD<t t-out="sub_line"/>^FS
^FO0,200^FB812,1,0,C^A0N,55,45^FD<t t-out="tmpl.id"/>^FS
</t>

<!-- EXACT CODE 128 CENTERING MATH FOR ^BY1 -->
<t t-set="barcode_val" t-value="quant.product_id.barcode or package.name if quant else package.name"/>
<t t-set="barcode_len" t-value="len(barcode_val) if barcode_val else 0"/>
<t t-set="barcode_x" t-value="int(388 - (barcode_len * 5.5))"/>
<t t-if="barcode_x &lt; 10">
    <t t-set="barcode_x" t-value="10"/>
</t>

^FO<t t-out="barcode_x"/>,260^BY1,3,90
^BCN,90,N,N,N
^FD<t t-out="barcode_val"/>^FS

<!-- RETAINED PRECISE TEXT SIZE -->
^FO0,360^FB812,1,0,C^A0N,35,30^FD<t t-out="barcode_val"/>^FS

<!-- SHIFTED FOOTER VALUES DOWN -->
^FO10,470^FB250,1,0,C^A0N,30,28^FDCONOS^FS
^FO280,470^FB250,1,0,C^A0N,30,28^FDKGB^FS
^FO550,470^FB250,1,0,C^A0N,30,28^FDKGN^FS

^FO10,520^FB250,1,0,C^A0N,42,38^FD<t t-out="package.cantidad_conos or ''"/>^FS
^FO280,520^FB250,1,0,C^A0N,42,38^FD<t t-out="package.peso_bruto or ''"/>^FS
^FO550,520^FB250,1,0,C^A0N,42,38^FD<t t-out="package.peso_neto or ''"/>^FS
^XZ
                </t>
            </xpath>
        </template>
    </data>
</odoo>