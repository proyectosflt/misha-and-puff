<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="label_package_template_view_inherit" inherit_id="stock.label_package_template_view">
            <xpath expr="//t[@t-translation='off']" position="replace">
                <t t-translation="off">
^XA
^PW812
^LL1218
<t t-set="quant" t-value="package.quant_ids and package.quant_ids[0]"/>
<t t-set="tmpl" t-value="quant.product_tmpl_id if quant else False"/>
<t t-if="tmpl">
    <t t-set="tenido" t-value="tmpl.product_tenido_id.codigo or ''"/>
    <t t-set="color" t-value="tmpl.product_color_id.codigo or ''"/>
    <t t-set="top_line" t-value="((tenido + '-') if (tenido and color) else tenido) + color"/>
    
    <t t-set="props" t-value="tmpl.product_familia_id.property_ids.sorted(lambda p: p.sequence)"/>
    <t t-set="rest_codes" t-value="[tmpl[p.property_field].codigo for p in props if p.property_field not in ('product_tenido_id', 'product_color_id') and tmpl[p.property_field] and tmpl[p.property_field].codigo]"/>
    <t t-set="sub_line" t-value="'-'.join(rest_codes)"/>

^FO680,0^FB1218,1,0,C^A0R,85,70^FD<t t-out="top_line"/>^FS
^FO590,0^FB1218,1,0,C^A0R,65,55^FD<t t-out="sub_line"/>^FS
^FO510,0^FB1218,1,0,C^A0R,55,45^FD<t t-out="tmpl.id"/>^FS
</t>

<!-- RECALCULATED CODE 128 CENTERING FOR 1218 LENGTH WITH ^BY2 -->
<t t-set="barcode_val" t-value="quant.product_id.barcode or package.name if quant else package.name"/>
<t t-set="barcode_len" t-value="len(barcode_val) if barcode_val else 0"/>
<!-- 1218/2 = 609. Barcode overhead is 70 dots. 609 - 35 = 574. Character width is 22, half is 11 -->
<t t-set="barcode_y" t-value="int(574 - (barcode_len * 11))"/>
<t t-if="barcode_y &lt; 10">
    <t t-set="barcode_y" t-value="10"/>
</t>

^FO370,<t t-out="barcode_y"/>^BY2,3,120
^BCR,120,N,N,N
^FD<t t-out="barcode_val"/>^FS

^FO280,0^FB1218,1,0,C^A0R,40,35^FD<t t-out="barcode_val"/>^FS

^FO280,0^FB1218,1,0,C^A0R,40,35^FD<t t-out="barcode_val"/>^FS

<!-- FOOTER VALUES SPREAD VERTICALLY ACROSS 6-INCH LENGTH -->
^FO130,40^FB350,1,0,C^A0R,35,30^FDCONOS^FS
^FO130,434^FB350,1,0,C^A0R,35,30^FDKGB^FS
^FO130,828^FB350,1,0,C^A0R,35,30^FDKGN^FS

^FO60,40^FB350,1,0,C^A0R,45,40^FD<t t-out="package.cantidad_conos or ''"/>^FS
^FO60,434^FB350,1,0,C^A0R,45,40^FD<t t-out="package.peso_bruto or ''"/>^FS
^FO60,828^FB350,1,0,C^A0R,45,40^FD<t t-out="package.peso_neto or ''"/>^FS
^XZ
                </t>
            </xpath>
        </template>
    </data>
</odoo>