<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Confirmation Wizard View -->
    <record id="view_stock_repack_confirm_wizard_form" model="ir.ui.view">
        <field name="name">stock.repack.confirm.wizard.form</field>
        <field name="model">stock.repack.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar Remanente de Inventario">
                <field name="repack_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    Existe una cantidad restante de <field name="remaining_qty" class="fw-bold"/> sin empacar.
                    <br/><br/>
                    <strong>¿Desea eliminar las cantidades remanentes del inventario?</strong>
                </div>
                <footer>
                    <button name="action_confirm_yes" type="object" string="Sí, eliminar remanente" class="btn-primary"/>
                    <button name="action_confirm_no" type="object" string="No, conservar remanente" class="btn-secondary"/>
                    <button string="Cancelar" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_stock_repack_tree" model="ir.ui.view">
        <field name="name">stock.repack.tree</field>
        <field name="model">stock.repack</field>
        <field name="arch" type="xml">
            <list string="Empacados por conteo">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="theoretical_qty"/>
                <field name="remaining_qty"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_stock_repack_form" model="ir.ui.view">
        <field name="name">stock.repack.form</field>
        <field name="model">stock.repack</field>
        <field name="arch" type="xml">
            <form string="Empacado por conteo con corrección de inventario">
                <header>
                    <button name="action_apply" type="object" string="Validar y Finalizar" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="location_id"/>
                        </group>
                        <group>
                            <field name="theoretical_qty" readonly="1"/>
                            <field name="remaining_qty" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Paquetes" name="packages">
                            <field name="line_ids" context="{'default_location_id': location_id}">
                                <list editable="bottom">
                                    <field name="location_id"/>
                                    <field name="package_type_id"/>
                                    <field name="cono_id"/>
                                    <!-- sum="Total Conos" adds total row at footer -->
                                    <field name="cantidad_conos" sum="Total Conos"/>
                                    <!-- sum="Total Peso Bruto" adds total row at footer -->
                                    <field name="peso_bruto" sum="Total Peso Bruto"/>
                                    <field name="tara_bolsa"/>
                                    <field name="tara_cono"/>
                                    <field name="tara_cono_total" readonly="1"/>
                                    <!-- sum="Total Peso Neto" adds total row at footer -->
                                    <field name="peso_neto" readonly="1" sum="Total Peso Neto"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_stock_repack" model="ir.actions.act_window">
        <field name="name">Empacado por conteo</field>
        <field name="res_model">stock.repack</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_stock_repack"
              name="Empacado por conteo"
              parent="stock.menu_stock_adjustments"
              action="action_stock_repack"
              sequence="2"/>
              
</odoo>