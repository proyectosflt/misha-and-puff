<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_search_view_inherit_flt_stock_extended" model="ir.ui.view">
        <field name="name">product.product.search.inherit.flt.stock.extended</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='name']" position="after">
                <field name="codificacion_anterior"/>
            </xpath>
        </field>
    </record>
</odoo>
