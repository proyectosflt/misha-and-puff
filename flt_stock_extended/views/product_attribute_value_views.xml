<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_attribute_value_color_list" model="ir.ui.view">
        <field name="name">product.attribute.value.color.list</field>
        <field name="model">product.attribute.value</field>
        <field name="arch" type="xml">
            <list string="Colors" editable="bottom">
                <field name="name" string="Código"/>
                <field name="nombre"/>
                <field name="color_family_id"/>
            </list>
        </field>
    </record>

    <record id="view_product_attribute_value_color_form" model="ir.ui.view">
        <field name="name">product.attribute.value.color.form</field>
        <field name="model">product.attribute.value</field>
        <field name="arch" type="xml">
            <form string="Color">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="nombre"/>
                        <field name="color_family_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_attribute_value_color" model="ir.actions.act_window">
        <field name="name">Colores</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.attribute.value</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('attribute_id.name', '=', 'Color')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_product_attribute_value_color_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_product_attribute_value_color_form')})]"/>
    </record>

    <menuitem id="menu_product_attribute_value_color"
              name="Colores"
              parent="stock.menu_product_in_config_stock"
              action="action_product_attribute_value_color"
              sequence="51"/>

</odoo>
