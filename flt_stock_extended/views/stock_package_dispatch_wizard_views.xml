<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Selección masiva de paquetes para despacho -->
    <record id="view_stock_package_dispatch_wizard_form" model="ir.ui.view">
        <field name="name">stock.package.dispatch.wizard.form</field>
        <field name="model">stock.package.dispatch.wizard</field>
        <field name="arch" type="xml">
            <form string="Selección de paquetes">
                <field name="move_id" invisible="1"/>
                <group col="6">
                    <group colspan="2" string="Producto">
                        <field name="product_id" readonly="1"/>
                        <field name="color_code" readonly="1"/>
                        <field name="descripcion" readonly="1" class="text-truncate"/>
                    </group>
                    <group colspan="2" string="Despacho">
                        <field name="demand_qty" readonly="1"/>
                        <field name="selected_count" readonly="1"/>
                        <field name="selected_conos" readonly="1"/>
                        <field name="selected_bruto" readonly="1"/>
                        <field name="selected_qty" readonly="1"/>
                    </group>
                    <group colspan="2" string="Diferencia">
                        <field name="difference_qty" readonly="1" nolabel="1" colspan="2"
                               class="fs-2 fw-bold"
                               decoration-success="difference_qty == 0"
                               decoration-warning="difference_qty &lt; 0"
                               decoration-danger="difference_qty &gt; 0"/>
                        <div colspan="2" class="text-muted small">
                            Negativa: falta completar. Positiva: se excede la demanda.
                        </div>
                        <field name="breakdown_count" invisible="1"/>
                        <field name="breakdown_base_qty" readonly="1" invisible="not breakdown_count"/>
                        <field name="breakdown_target_qty" readonly="1" invisible="not breakdown_count"
                               class="fw-bold"/>
                    </group>
                </group>

                <div class="d-flex gap-2 mb-2">
                    <button name="action_select_all" type="object" string="Seleccionar todos"
                            icon="fa-check-square-o" class="btn-secondary"/>
                    <button name="action_unselect_all" type="object" string="Quitar selección"
                            icon="fa-square-o" class="btn-secondary"/>
                    <button name="action_open_breakdown" type="object" string="Desglosar marcados"
                            icon="fa-scissors" class="btn-warning"
                            invisible="not breakdown_count"/>
                </div>

                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0"
                          decoration-info="is_new" decoration-bf="selected">
                        <field name="selected" widget="boolean_toggle" nolabel="1"/>
                        <field name="package_id" readonly="1"/>
                        <field name="location_id" readonly="1" optional="show"/>
                        <field name="color_code" readonly="1" optional="show"/>
                        <field name="descripcion" readonly="1" optional="show"/>
                        <field name="cantidad_conos" readonly="1" sum="Total conos"/>
                        <field name="peso_bruto" readonly="1" sum="Total bruto"/>
                        <field name="peso_neto" readonly="1" sum="Total neto"/>
                        <field name="is_new" readonly="1" optional="show"/>
                        <field name="to_breakdown" widget="boolean_toggle"/>
                    </list>
                </field>

                <footer>
                    <button name="action_confirm" type="object" string="Aceptar" class="btn-primary"
                            data-hotkey="q"/>
                    <button name="action_cancel" type="object" string="Cancelar" class="btn-secondary"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Botón en el detalle de operaciones del movimiento de despacho -->
    <record id="view_stock_move_operations_package_selection" model="ir.ui.view">
        <field name="name">stock.move.operations.package.selection</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_line_ids']" position="before">
                <field name="state" invisible="1"/>
                <div class="mb-2" invisible="picking_code != 'outgoing' or state in ('done', 'cancel')">
                    <button name="action_open_package_selection" type="object"
                            string="Seleccionar paquetes" icon="fa-cubes" class="btn-primary"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
