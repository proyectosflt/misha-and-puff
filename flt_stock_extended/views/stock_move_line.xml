<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_tree_inherit" model="ir.ui.view">
        <field name="name">view.move.line.tree.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='result_package_id' and not(@column_invisible='True')]" position="attributes">
                <attribute name="column_invisible">parent.picking_type_id != 1</attribute>
                <attribute name="readonly">1</attribute>
                <attribute name="string">Paquete creado</attribute>
            </xpath>
            <!-- <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="result_package_id" position="move"/>
            </xpath> -->
            <xpath expr="//field[@name='result_package_id' and not(@column_invisible='True')]" position="before">
                <!-- <field name="package_id" column_invisible="parent.picking_type_id == 1"/> -->
                <field name="package_type_id" column_invisible="parent.picking_type_id != 1"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="before">
                <!-- <field name="tara_bolsa" column_invisible="parent.picking_type_id != 1"/>
                <field name="cantidad_conos" column_invisible="parent.picking_type_id != 1"/>
                <field name="tara_cono" column_invisible="parent.picking_type_id != 1"/>
                <field name="peso_bruto" column_invisible="parent.picking_type_id != 1"/>
                <field name="peso_neto" column_invisible="parent.picking_type_id != 1"/> -->
                <field name="reference" column_invisible="1"/>
                <field name="date" column_invisible="1"/>
                <field name="product_barcode" column_invisible="1"/>
                <field name="location_processed" column_invisible="1"/>
                <field name="lots_visible" column_invisible="1"/>
                <field name="tara_bolsa"/> 
                <field name="cono_id"/>
                <field name="tara_cono"/>
                <field name="cantidad_conos" sum="Total conos"/> 
                <field name="tara_cono_total" sum="Total tara conos"/>
                <field name="peso_bruto" sum="Total peso bruto"/>
                <field name="peso_neto" sum="Total peso neto"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <button name="action_duplicar" string="Duplicar" type="object"
                        column_invisible="parent.state in ('done', 'cancel')"/>
                <button name="action_apply_package" string="Aplicar" type="object" icon="fa-check"
                    column_invisible="parent.picking_type_id != 1"
                    invisible="result_package_id or parent.state in ('done', 'cancel')"/>
                <button name="action_print_zpl_label" string="Imprimir ZPL" type="object" icon="fa-print"
                    column_invisible="parent.picking_type_id != 1"
                    invisible="not result_package_id or parent.state == 'cancel'"/>
            </xpath>

        </field>
    </record>

    <record id="view_move_line_detailed_tree_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operation.tree.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">

             <xpath expr="//field[@name='result_package_id' and not(@column_invisible='True')]" position="attributes">
                <!-- <attribute name="column_invisible">parent.picking_type_code != 'incoming'</attribute> -->
                <attribute name="readonly">1</attribute>
                <attribute name="string">Paquete creado</attribute>
            </xpath>
             <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="result_package_id" position="move"/>
            </xpath>
             <xpath expr="//field[@name='result_package_id' and not(@column_invisible='True')]" position="before">
                <!-- <field name="package_id"/> -->
                <field name="package_type_id"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="tara_bolsa"/>
                <field name="cono_id"/>
                <field name="cantidad_conos"/>
                <field name="tara_cono"/>
                <field name="tara_cono_total"/>
                <field name="peso_bruto"/>
                <field name="peso_neto"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="picking_id" column_invisible="True"/>
                <field name="picking_type_code" column_invisible="True"/>
                <field name="state" column_invisible="True"/>
                <button name="action_apply_package" string="Aplicar" type="object" icon="fa-check"
                    invisible="picking_type_code != 'incoming' or result_package_id or state in ('done', 'cancel')"/>
                <button name="action_print_zpl_label" string="Imprimir ZPL" type="object" icon="fa-print"
                    invisible="picking_type_code != 'incoming' or not result_package_id or state == 'cancel'"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_subcontracting_move_line_tree_inherit" model="ir.ui.view">
    <field name="name">mrp.subcontracting.move.line.tree.inherit</field>
    <field name="model">stock.move.line</field>
    <!-- Inherit the specific move line tree used by mrp_subcontracting -->
    <field name="inherit_id" ref="mrp_subcontracting.mrp_subcontracting_stock_move_line_tree_view"/>
    <field name="arch" type="xml">
        <!-- Adjust the xpath target depending on your exact Odoo version (e.g., 'qty_done' or 'quantity') -->
        <xpath expr="//field[@name='quantity']" position="before">
            <field name="tara_bolsa"/>
            <field name="cono_id"/>
            <field name="tara_cono"/>
            <field name="cantidad_conos"/>
            <field name="tara_cono_total"/>
            <field name="peso_bruto"/>
            <field name="peso_neto"/>
        </xpath>
        <xpath expr="//list" position="inside">
            <button name="action_duplicar" string="Duplicar" type="object"
                    column_invisible="parent.state in ('done', 'cancel')"/>
        </xpath>
    </field>
</record>

    <record id="view_stock_move_operations_force_list" model="ir.ui.view">
    <field name="name">stock.move.operations.force.list</field>
    <field name="model">stock.move</field>
    <field name="inherit_id" ref="stock.view_stock_move_operations"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='move_line_ids']" position="attributes">
            <attribute name="mode">list</attribute>
        </xpath>
        <xpath expr="//field[@name='product_uom_qty']/ancestor::div[@class='o_row']" position="after">
            <field name="quantity" string="Cantidad" readonly="1" invisible="picking_code != 'outgoing'"/>
        </xpath>
        <xpath expr="//form/group/group[2]" position="inside">
            <field name="tolerancia_venta" string="Tolerancia venta" invisible="picking_code != 'outgoing'"/>
            <field name="tolerancia_compra" string="Tolerancia compra" invisible="picking_code != 'incoming'"/>
            <field name="diferencia_demanda" string="Diferencia" readonly="1"/>
        </xpath>
    </field>
</record>
</odoo>
