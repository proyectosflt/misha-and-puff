<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_tree_inherit" model="ir.ui.view">
        <field name="name">view.move.line.tree.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="tara_bolsa" column_invisible="parent.picking_type_code != 'incoming'"/>
                <field name="cantidad_conos" column_invisible="parent.picking_type_code != 'incoming'"/>
                <field name="tara_cono" column_invisible="parent.picking_type_code != 'incoming'"/>
                <field name="peso_bruto" column_invisible="parent.picking_type_code != 'incoming'"/>
                <field name="peso_neto" column_invisible="parent.picking_type_code != 'incoming'"/>
            </xpath>
            <xpath expr="//list" position="inside">
                <button name="action_calcular" string="Calcular" type="object" 
                        column_invisible="parent.state in ('done', 'cancel') or parent.picking_type_code != 'incoming'"/>
            </xpath>
        </field>
    </record>
</odoo>
